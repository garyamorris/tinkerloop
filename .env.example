# Copy to .env.local. Existing environment variables take precedence.
TINKERLOOP_PROVIDER=openai
# Set this to a tool-capable model ID from your provider's catalog.
TINKERLOOP_MODEL=

# Only the selected provider needs a key. Never commit .env.local.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# For --provider compatible, include the API prefix (usually /v1).
# This connector uses Chat Completions, not the Responses API.
TINKERLOOP_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
